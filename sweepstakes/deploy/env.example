# /etc/sweep/env (root:sweep 0640) に置く。systemd の EnvironmentFile から読まれる
# setup.sh は初回だけこのファイルをコピーし、SWEEP_MCP_TOKEN を自動生成する

# MCP の認証トークン (必須・32 文字以上)。生成: openssl rand -hex 32
SWEEP_MCP_TOKEN=change-me-generate-with-openssl-rand-hex-32
# 待ち受け (Caddy から 127.0.0.1:8787 に転送する。外部に直接公開しない)
SWEEP_MCP_HOST=127.0.0.1
SWEEP_MCP_PORT=8787
# Caddy 経由 (ループバック接続) のとき X-Forwarded-For を接続元 IP として認証失敗のレート制限に使う。0 で無効
SWEEP_MCP_TRUST_PROXY=1

# 日次上限の「1 日」はローカル時刻 0 時起点なので日本時間にする
TZ=Asia/Tokyo

# データの置き場所 (systemd の ReadWritePaths と合わせる)
SWEEP_DB=/opt/sweep/data/sweep.db
SWEEP_PROFILE=/opt/sweep/data/profile.json
SWEEP_SCREENSHOT_DIR=/opt/sweep/data/screenshots
# setup.sh が Chromium を入れた場所
PLAYWRIGHT_BROWSERS_PATH=/opt/sweep/ms-playwright
# Playwright の Chromium が動かない場合はディストリビューションの Chromium を指定
# SWEEP_CHROMIUM_PATH=/usr/bin/chromium

# 送信間隔 (秒、この範囲でランダム) と 1 日の送信上限
SWEEP_MIN_INTERVAL_SEC=60
SWEEP_MAX_INTERVAL_SEC=180
SWEEP_DAILY_LIMIT=30

# 仮想通貨クエストの USD 系報酬の円換算レート (任意)
# SWEEP_USDJPY=150

# 定期実行 (sweep-run.timer) で実際に送信するか。1 のときだけ run --submit。既定は dry-run
SWEEP_AUTO_SUBMIT=0
# 定期実行の収集カテゴリ (カンマ区切り。空なら all ページ → 全サブカテゴリ) と詳細取得の上限
SWEEP_RUN_CATEGORIES=
SWEEP_RUN_MAX_DETAILS=60
