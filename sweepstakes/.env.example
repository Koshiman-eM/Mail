# 懸賞ツールの環境変数 (Windows PC での常用向けの例)
# このファイルを .env にコピーして使う (deploy/windows/setup.ps1 が初回だけ自動でコピーし、トークンも生成する)。
# npm run sweep / npm run mcp は sweepstakes ディレクトリの .env を自動で読み込む (Node 22.9+ の --env-file-if-exists)。
# 既に OS の環境変数に同じ名前があれば、そちらが優先される。
# .env は .gitignore 済み。トークンを含むので共有しないこと。

# MCP の認証トークン (必須・32 文字以上・スラッシュ不可)。setup.ps1 が 64 桁の 16 進数で生成する
SWEEP_MCP_TOKEN=change-me-generate-64-hex
# 待ち受け。cloudflared が同じ PC から 127.0.0.1:8787 に転送するので、外部 (0.0.0.0) には公開しない
SWEEP_MCP_HOST=127.0.0.1
SWEEP_MCP_PORT=8787
# ループバック接続 (cloudflared 経由) のとき X-Forwarded-For を接続元 IP として認証失敗のレート制限に使う。0 で無効
SWEEP_MCP_TRUST_PROXY=1

# 定期実行 (タスク スケジューラの SweepRun) で実際に送信するか。1 のときだけ run --submit。
# まず 0 (dry-run: 送信直前で止めてスクリーンショットだけ保存) で様子を見ること
SWEEP_AUTO_SUBMIT=0

# データの置き場所 (相対パスは sweepstakes ディレクトリ基準)
SWEEP_DB=./data/sweep.db
SWEEP_PROFILE=./profile.json
SWEEP_SCREENSHOT_DIR=./data/screenshots
# ブラウザ操作・収集のプロセス間ロック (既定: DB と同じフォルダの browser.lock)
# SWEEP_LOCK_PATH=./data/browser.lock

# 日次上限の「1 日」の境界のタイムゾーン (既定 Asia/Tokyo)。
# Windows では TZ=Asia/Tokyo が効かない場合があるため、日次上限はこの値で計算する。
# 締切 (YYYY-MM-DD → その日の 23:59) は PC のタイムゾーン (日本の PC なら JST) で判定する
# SWEEP_TIMEZONE=Asia/Tokyo

# 送信間隔 (秒、この範囲でランダム) と 1 日の送信上限
SWEEP_MIN_INTERVAL_SEC=60
SWEEP_MAX_INTERVAL_SEC=180
SWEEP_DAILY_LIMIT=30

# 仮想通貨クエストの USD 系報酬の円換算レート (任意)
# SWEEP_USDJPY=150

# 定期実行の収集カテゴリ (カンマ区切り。空なら all → 全サブカテゴリ) と詳細取得の上限 (run-once.ps1 が使う)
SWEEP_RUN_CATEGORIES=
SWEEP_RUN_MAX_DETAILS=60

# ブラウザを表示して動きを確認したいときは 0 (タスク スケジューラ実行時は 1 のままにする)
# SWEEP_HEADLESS=1
