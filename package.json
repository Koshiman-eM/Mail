{
  "name": "sedori-import-assistant",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "worker": "tsx --env-file-if-exists=.env.local --env-file-if-exists=.env src/workers/index.ts",
    "db:generate": "prisma generate",
    "db:migrate": "dotenv -e .env.local -e .env -- prisma migrate dev",
    "postinstall": "prisma generate",
    "db:deploy": "dotenv -e .env.local -e .env -- prisma migrate deploy",
    "jobs:once": "tsx --env-file-if-exists=.env.local --env-file-if-exists=.env src/workers/once.ts",
    "start:prod": "prisma migrate deploy && next start -p ${PORT:-3000}",
    "db:seed:demo": "tsx --env-file-if-exists=.env.local --env-file-if-exists=.env prisma/seed.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.10.0",
    "@neon/config": "^1.14.3",
    "@neon/env": "^2.1.6",
    "@prisma/client": "^6.19.3",
    "@radix-ui/react-slot": "^1.5.0",
    "@tanstack/react-query": "^5.108.0",
    "bullmq": "^6.7.7",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "decimal.js": "^10.6.0",
    "ioredis": "^6.0.0",
    "lucide-react": "^1.75.0",
    "next": "^15.5.29",
    "prisma": "^6.19.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwind-merge": "^3.7.0",
    "web-push": "^4.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/web-push": "^3.6.4",
    "autoprefixer": "^10.6.2",
    "dotenv-cli": "^11.1.0",
    "playwright-core": "^1.65.1",
    "postcss": "^8.5.33",
    "tailwindcss": "^3.4.19",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.1.1"
  }
}
