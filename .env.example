# Copy this file to .env in the repo root and fill in the values you have.
# The app runs fine with none of these set: the API/UI still work, Gmail
# sync and LINE webhook just report as "not configured" until you add them.

PORT=4000
DB_PATH=./data/app.db

# Google Cloud Console > APIs & Services > Credentials > OAuth client ID
# (type: Web application). Enable the Gmail API and Google Calendar API on
# the project, add the redirect URI below to the client's allowed list.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:4000/auth/google/callback
# Calendar to create events on. "primary" is the account's main calendar.
GOOGLE_CALENDAR_ID=primary

# LINE Developers Console > your Messaging API channel.
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=

# When true (default), a detected schedule is pushed to Google Calendar
# immediately. When false, it's only listed as "pending" in the Events tab
# until you click "add to calendar" manually.
AUTO_CREATE_EVENTS=true

# Enables POST /api/dev/seed, used by the Settings > Demo button to try the
# app without real Gmail/LINE credentials. Set to false in production.
ENABLE_DEV_SEED=true
