# このファイルを .env.local にコピーして値を設定してください。
# シークレット (APIキー・セッション情報) は絶対にコードへハードコーディングしないこと。

DATABASE_URL="postgresql://postgres:postgres@localhost:5432/sedori?schema=public"
REDIS_URL="redis://localhost:6379"

# Claude API (翻訳・返信ドラフト生成)。未設定時はスタブ応答で動作します。
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5

# サプライヤー送信アダプター: mock | handoff | alibaba
#   mock    : 開発・テスト用 (必須)。外部送信しない
#   handoff : 本番用。アプリは送信せず、承認後に本文をコピー/共有して業者アプリで送り、「送信しました」で記録する
#   alibaba : 自動送信 (未実装。NODE_ENV=production でのみ選択可)
SUPPLIER_ADAPTER=mock

# 為替: 既定のバッファ率 (%)
FX_DEFAULT_BUFFER_PERCENT=3

# スクレイピングワーカー
SCRAPE_CONCURRENCY=2
SCRAPE_MAX_ATTEMPTS=5
SCRAPE_BACKOFF_BASE_MS=30000
SCRAPE_JITTER_MAX_MS=15000
# 商品ページの取得方法: http | playwright (未設定時: ワーカー・定期ジョブは playwright、Web アプリ内は http)
SCRAPER_MODE=
# 定期ジョブで同じ商品を再取得する最短間隔 (時間)
SCRAPE_MIN_INTERVAL_HOURS=6
# Chromium / Chrome の実行ファイル (playwright 使用時。未設定なら Playwright 既定)
CHROMIUM_PATH=
# Playwright のセッション保存先 (storageState JSON)。リポジトリ外に置くこと。
SCRAPER_STORAGE_STATE_PATH=

# 全商品の利益を自動再計算する間隔 (ミリ秒)。為替の変動を反映するため。既定 6 時間
PROFIT_RECALC_INTERVAL_MS=21600000

# 公開 URL (通知のリンク等。Render では自動設定されるため不要)
APP_URL=

# Web Push の鍵 (任意)。未設定ならアプリが自動生成してデータベースに保存します
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
