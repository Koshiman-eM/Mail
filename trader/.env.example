# ───────── 動作モード ─────────
# 既定は paper (仮想売買)。実弾は次の 2 行が両方揃ったときだけ有効になる。
TRADING_MODE=paper
# LIVE_TRADING_CONFIRM=I_UNDERSTAND_REAL_MONEY_RISK

# 使う取引先 (カンマ区切り)。synthetic はネット接続なしで動く合成データ。
# 例: VENUES=ccxt,oanda,alpaca,dex / GMOコインなら VENUES=gmo
VENUES=synthetic
# 監視銘柄 "venue|symbol|assetClass" をカンマ区切り。空なら venue ごとの既定銘柄。
# 例: WATCHLIST=ccxt|BTC/JPY|crypto,ccxt|PEPE/USDT|meme,oanda|USD/JPY|fx,alpaca|AAPL|stock
WATCHLIST=
BASE_CURRENCY=JPY
PAPER_INITIAL_EQUITY=1000000
# paper でだけ、現物の暗号資産 (空売り不可) の空売りを再現して学習する (live では常に空売りしない。meme・DEX は対象外)
PAPER_SIMULATE_SHORT=true
# 再現する空売りの借入コスト (建玉代金に対する日率。0〜0.01)。0.0004 = 0.04%/日は仮の値。実際の料率は取引所で確認
PAPER_SHORT_BORROW_RATE_DAILY=0.0004
DB_PATH=./data/trader.db

# ───────── AI (Claude) ─────────
# 未設定でも動く (ニュース分析・振り返りはルールベースに切り替わる)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5

# ───────── 暗号資産取引所 (ccxt 対応の取引所名) ─────────
# 推奨は bitbank (ローソク足を取得できる)。
# bitflyer は ccxt で OHLCV (ローソク足) を提供していないため、足は気配 (bid/ask) から組み立てる。
#   出来高は 0、再起動で足の履歴が消える、バックテストの --source ccxt は使えない。
# (環境変数を設定しなかった場合のコード上の既定も bitbank)
CCXT_EXCHANGE=bitbank
CCXT_API_KEY=
CCXT_SECRET=
# パスフレーズが必要な取引所 (OKX, KuCoin 等) だけ。bitbank / bitFlyer では不要
CCXT_PASSWORD=

# ───────── GMOコイン (取引所 レバレッジ取引) ─────────
# 使うときは VENUES=gmo (他と併用するなら VENUES=gmo,oanda など)。価格は公開 API、取引はレバレッジ銘柄 (BTC_JPY など)。
# 空売り (売りからの新規建て) もできる。反対側の建玉があるときの新規は両建てを避けるため送らない。
# 応答の形の確認 (注文・取消は呼ばない): npm run trader -- gmo check
# VENUES=gmo
# 使うレバレッジ銘柄 (GMO の表記、カンマ区切り)。WATCHLIST に gmo|BTC/JPY|crypto のように書けばそちらを優先
GMO_SYMBOLS=BTC_JPY,ETH_JPY,XRP_JPY
# API キー (live の発注と gmo check の読み取り専用 API だけに使う。paper では不要)。.env.local に書く
GMO_API_KEY=
GMO_API_SECRET=
# 建玉の持ち越し手数料 (レバレッジ手数料) の日率 (0〜0.01)。0.0004 = 0.04%/日 (要確認)。
# paper では日本時間 6:00 をまたいで保有した回数 × 建玉代金 × 日率を手数料に計上する (買い・売りとも)
GMO_LEVERAGE_FEE_DAILY=0.0004
# GMO の建玉の合計の上限 (評価額の何倍まで、0.1〜2)。GMO は 2 倍まで建てられるが、既定 1 (レバレッジを掛けない)
GMO_MAX_EFFECTIVE_LEVERAGE=1
# レバレッジ銘柄の足が取れないとき現物銘柄 (BTC など) の足に切り替えるか。paper は常に許可 (警告と監査ログ gmo.spot_candles)。
# live では true のときだけ許可し、false (既定) なら切り替えずに例外
GMO_ALLOW_SPOT_CANDLES=false

# ───────── FX (OANDA v20) ─────────
OANDA_API_TOKEN=
OANDA_ACCOUNT_ID=
OANDA_ENV=practice

# ───────── 米国株 (Alpaca) ─────────
ALPACA_KEY_ID=
ALPACA_SECRET_KEY=
ALPACA_PAPER=true

# ───────── 情報収集 ─────────
# CryptoPanic の API トークン。空なら CryptoPanic は使わない
CRYPTOPANIC_TOKEN=
# RSS (カンマ区切り URL)。既定の 4 フィード (CoinDesk, Cointelegraph, CNBC, BBC Business) に追加する。
# 先頭に = を付けると既定を置き換える。例: NEWS_RSS_FEEDS==https://example.com/a.xml,https://example.com/b.xml
NEWS_RSS_FEEDS=

# ───────── リスク (口座評価額に対する比率) ─────────
# 割合は 1 = 100% で書く (0.5 は 50% の意味。0.5% なら 0.005)。範囲外だと起動時にエラーで止まる。
#   RISK_PER_TRADE: 0 より大きく 0.05 以下 / MAX_DAILY_LOSS: 0.2 以下 / MAX_DRAWDOWN: 0.5 以下
#   MAX_POSITION_PCT, MAX_EXPOSURE_*: 1 以下 / MAX_OPEN_POSITIONS: 1〜100 の整数
RISK_PER_TRADE=0.005
MAX_DAILY_LOSS=0.03
MAX_DRAWDOWN=0.15
MAX_OPEN_POSITIONS=8
MAX_POSITION_PCT=0.2
MAX_ORDERS_PER_MINUTE=30
# 期待値幅が (往復手数料 + スプレッド) の何倍以上なら入るか。
# コスト控除後の期待値を出す戦略 (scalp_micro・scalp_rebound・scalp_pullback・pullback_5m・pullback_15m) は、
# コストを二重に数えないよう「期待値 ≥ max(0, この値 − 1) × コスト かつ 期待値 > 0」で判定する (テンポの有無によらない)
MIN_EDGE_TO_COST=2
MAX_EXPOSURE_CRYPTO=0.6
MAX_EXPOSURE_MEME=0.05
MAX_EXPOSURE_FX=0.6
MAX_EXPOSURE_STOCK=0.6
MEME_MIN_LIQUIDITY_USD=250000

# ───────── エントリー頻度の目標 (テンポ) と保有時間の上限 ─────────
# 1 時間あたりの目標のエントリー回数 (0〜60。0 = 無効)。6 ならおおむね 10 分に 1 回。
# エントリーが途切れているときだけ、戦略と RiskManager の決められた条件を決められた下限まで緩める (リスクは上がる)
TARGET_ENTRIES_PER_HOUR=0
# 新規エントリーの最大保有時間 (分。0 = 無効、それ以外は 5〜1440)。
# 有効なら中期・長期の戦略は発注せず仮想トレード (hold_limit) としてだけ記録し、ほかの戦略は最大保有をこの分数までに縮める。
# 読みの管理 (THESIS_EXIT=true) のときは「読みの期限」の上限になる (利益が出ている建玉は 期限 × THESIS_EXTEND_MULT まで持つ)
MAX_HOLD_MINUTES=0
# テンポのモードで MIN_EDGE_TO_COST を緩める下限 (1〜10)
TEMPO_MIN_EDGE_TO_COST=1
# 直近 1 時間のエントリーが 目標 × これ (切り上げ) に達したら新規エントリーを止める (1〜5)
TEMPO_CAP_MULTIPLIER=2
# 探索のエントリー (緩めた結果、コスト控除後の期待値が 0 以下のシグナル) のサイズの倍率 (0.1〜1)
TEMPO_EXPLORE_SIZE=0.5
# live でも探索のエントリーを許可する (paper では常に許可)。実際の資金で期待値 0 以下の取引をするので慎重に
TEMPO_ALLOW_LIVE_EXPLORE=false

# ───────── 読みの管理 (いつまでに利益が出る読みかを決めて答え合わせ) ─────────
# true: エントリー時に「読みの期限」(戦略の expectedMs、無ければ最大保有) を決め、
#   - 期限の半分を過ぎて大きく逆行していたら途中で決済 (読み外れ・途中)
#   - 期限の時点で利益が出ていなければ決済 (読み外れ・期限)
#   - 利益が出ていれば、損切りを建値 (手数料込み) とトレーリングへ引き上げて 期限 × THESIS_EXTEND_MULT まで持ち続ける
# false: 従来どおり最大保有で時間切れにする
THESIS_EXIT=true
# 期限の時点で、手数料を引いた純 R (1R = 当初の損切り幅) がこれ以上なら読み当たりとして延長 (0〜2)
THESIS_MIN_R=0.1
# 期限の半分を過ぎて、値動きだけの R (手数料・スプレッドを含めない) が −これ 以下なら途中で決済 (0〜1。0 = 途中の決済なし)
THESIS_EARLY_CUT_R=0.5
# 延長の上限 (読みの期限の何倍まで持ち続けるか。1〜20。1 = 延長しない)
THESIS_EXTEND_MULT=4
# 延長後のトレーリングの幅 (1R の何倍。0.1〜3)。最も有利な価格からこれだけ戻したら決済 (建値より下には置かない)
THESIS_TRAIL_R=0.5

# ───────── 転換で決済 (トレンドがはっきり転換したら、利確・損切りの手前でも決済) ─────────
# true: 保有中の建玉について、REVERSAL_EXIT_TF の時間足でエントリー後にできた押し安値 (買い) / 戻り高値 (売り) を、
#   確定足の終値が割ったら (越えたら) 成行で決済する (決済理由 reversal = 転換で決済)。含み益でも含み損でも同じ。全戦略が対象
#   エントリー後にまだスイングができていなければ何もしない (当初の損切りが守る)。ヒゲだけでは決済しない
# false: 従来どおり (利確・損切り・トレーリング・読みの管理・戦略の決済シグナルだけ)
REVERSAL_EXIT=true
# スイング (押し安値・戻り高値) の判定の本数 (左右 N 本。2〜10 の整数。確定は N 本後)。新規エントリーのフィルターの STRUCTURE_PIVOT_N とは別
REVERSAL_EXIT_PIVOT_N=3
# 判定に使う時間足: lower (既定) = 戦略の主時間足の 1 つ下 (1m→1m, 5m→1m, 15m→5m, 1h→15m, 4h→1h, 1d→4h)、same = 戦略の主時間足
# (lower は短い保有でも押し安値割れ・戻り高値超えを拾いやすい。バックテストで基準足から作れなければ same で判定する)
REVERSAL_EXIT_TF=lower
# true: エントリー後にまだスイングができていなければ、エントリーした足の安値 (買い) / 高値 (売り) を水準にする (フォールバック)。
# 既定 false: 早く発火しすぎる (合成データの simulate でほとんどの取引をエントリー付近で閉じ、転換で決済の勝率は 5% 前後だった)
REVERSAL_EXIT_FALLBACK=false
# 終値が水準をこの ATR(14) の倍数より大きく越えたら決済 (0〜1。0 = 終値が越えれば十分)。ノイズで切られるなら少し上げる
REVERSAL_EXIT_BUFFER_ATR=0
# 対象の戦略 (カンマ区切り)。空 (既定) ならすべての戦略。未登録の id は起動時に警告する
# REVERSAL_EXIT_STRATEGIES=

# ───────── 指値 (maker) ─────────
# 新規エントリーを指値 (買いは最良の買い気配、売りは最良の売り気配) にする。期限内に約定しなければ見送り (仮想トレード limit_unfilled)
LIMIT_ENTRY=true
# 指値のエントリーの有効期限 (ミリ秒、1000〜86400000)。未設定なら主時間足の長さを 20 秒〜15 分に収めた値
# LIMIT_ENTRY_TIMEOUT_MS=
# 約定後に利確価格へ reduceOnly の指値を置く (paper 専用。live では true でも無視して起動時に警告)
LIMIT_TAKE_PROFIT=false

# ───────── 相場構造 (ダウ理論) のフィルター ─────────
# off = 従来どおり / filter = トレンドの向き (押し安値・戻り高値) に逆らうシグナルを見送る (仮想トレード strategy_filter:structure_*)
STRUCTURE_MODE=filter
# 対象の戦略 (カンマ区切り。未設定なら scalp_momentum_burst, scalp_micro, short_ema_trend, short_breakout, mid_trend_follow, long_momentum, meme_momentum)
# STRUCTURE_STRATEGIES=
# スイングの判定の本数 (3〜20。左右 N 本。確定は N 本後)
STRUCTURE_PIVOT_N=6
# ブレイクの判定: close (終値) / wick (ひげ)
STRUCTURE_BREAK_MODE=close
# 目線の判定: method1 (押し安値・戻り高値) / method2 (高値・安値の切り上げ・切り下げ) / both
STRUCTURE_BIAS_METHOD=method1
# 転換の判定: purist / conservative
STRUCTURE_REVERSAL_MODE=purist
# 上位足の目線と一致するときだけ入る
STRUCTURE_USE_MTF=true
# パーフェクトオーダー (SMA 5/20/50) の一致を条件にする
STRUCTURE_USE_PERFECT_ORDER=false
# 損切りの置き方: existing (戦略のまま) / structure (押し安値・戻り高値 ± ATR × バッファ)
STRUCTURE_STOP_MODE=existing
STRUCTURE_STOP_ATR_BUFFER=0.3
# 目線の転換・弱まりで保有中のポジションを決済する (ラップした戦略だけ)。
# REVERSAL_EXIT (全戦略・建玉に対する押し安値割れ / 戻り高値超え) と両方 true にするのは重複 (起動時に警告)
STRUCTURE_EXIT_ON_REVERSAL=false
STRUCTURE_EXIT_ON_WEAKENING=false
# もみ合いの判定: 直近 M 本 (5〜300) で目線が R 回以上入れ替わったら見送る
STRUCTURE_CHOP_M=50
STRUCTURE_CHOP_R=3

# ───────── ループ間隔 (ミリ秒) ─────────
SCALP_LOOP_MS=5000
INTEL_LOOP_MS=900000
LEARN_LOOP_MS=3600000
DASHBOARD_PORT=8787
# ダッシュボードの bind 先 (既定はローカルのみ。外部公開は非推奨)
DASHBOARD_HOST=127.0.0.1

# DexScreener のトレンドから流動性・安全性の条件を満たすミームを自動監視 (最大 5 件)
AUTO_MEME_WATCH=false

# ───────── その他 ─────────
# ログの出力レベル: debug / info / warn / error (既定 info。テスト中は warn)
# LOG_LEVEL=
# 外部 HTTP 応答の本文サイズの上限 (バイト、既定 10485760 = 10MB)
# HTTP_MAX_BODY_BYTES=

# 観測専用の戦略 (新規は発注せず仮想トレードだけ記録する。カンマ区切り。空にすると全戦略が実際に取引)。
# 既定は scalp_rebound と中期・長期の mid_trend_follow・long_momentum (中長期の新規エントリーはしない)。
# 観測専用にしても、保有中の建玉は従来どおり管理・決済する
OBSERVE_ONLY_STRATEGIES=scalp_rebound,mid_trend_follow,long_momentum
