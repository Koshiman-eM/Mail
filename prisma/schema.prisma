// 海外通販せどり支援ツール コアデータモデル
// 金額はすべて Decimal で保持し、浮動小数点誤差を防ぐ。

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Platform {
  ALIBABA
  ALI1688
  ALIEXPRESS
  OTHER
}

enum Severity {
  INFO
  WARNING
  CRITICAL
}

enum NotificationType {
  PRICE_CHANGE
  STOCK_CHANGE
  REAUTH_REQUIRED
  CHAT_RECEIVED
  DRAFT_READY
  SEND_FAILED
  SYSTEM
  DISCOVERY
}

/// 承認ステートマシン: RECEIVED -> DRAFT_READY -> APPROVED / REJECTED -> SENDING -> SENT
enum ChatStatus {
  RECEIVED
  DRAFT_READY
  APPROVED
  REJECTED
  SENDING
  SENT
  SEND_FAILED
}

enum ChatDirection {
  INBOUND
  OUTBOUND
}

/// 返信本文の作成者
enum DraftSource {
  AI
  MANUAL
}

model Supplier {
  id            String        @id @default(cuid())
  platform      Platform
  externalId    String
  name          String
  shopUrl       String?
  country       String?
  rating        Decimal?      @db.Decimal(4, 2)
  yearsActive   Int?
  /// 業者とのチャット画面の URL (送信時に開く。任意)
  chatUrl       String?
  isBlacklisted Boolean       @default(false)
  blacklistNote String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  products      Product[]
  messages      ChatMessage[]
  goals         NegotiationGoal[]

  @@unique([platform, externalId])
}

model Product {
  id                 String             @id @default(cuid())
  supplierId         String
  supplier           Supplier           @relation(fields: [supplierId], references: [id])
  platform           Platform
  externalId         String
  url                String
  title              String
  titleJa            String?
  currency           String             @db.VarChar(3)
  /// MOQ (最小発注数量)
  moq                Int                @default(1)
  /// 段階的単価: [{ minQty: number, unitPrice: string }]
  priceTiers         Json
  /// 国内比較対象 (例: Amazon ASIN / JAN)
  domesticRefId      String?
  domesticPriceJpy   Decimal?           @db.Decimal(14, 2)
  lengthCm           Decimal?           @db.Decimal(10, 2)
  widthCm            Decimal?           @db.Decimal(10, 2)
  heightCm           Decimal?           @db.Decimal(10, 2)
  weightKg           Decimal?           @db.Decimal(10, 3)
  hsCode             String?
  /// 自動利益計算の上書き値 (未設定なら既定値: 数量は MOQ、関税率は設定値)
  targetQuantity     Int?
  dutyPercent        Decimal?           @db.Decimal(6, 3)
  /// 直近の自動計算の状態 (OK / SKIPPED / ERROR) と理由
  autoCalcStatus     String?
  autoCalcNote       String?
  autoCalcAt         DateTime?
  /// 商品ページからの情報取得の状態 (PENDING / OK / FAILED) と理由
  fetchStatus        String?
  fetchNote          String?
  lastFetchedAt      DateTime?
  inStock            Boolean            @default(true)
  watch              Boolean            @default(true)
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  snapshots          PriceSnapshot[]
  simulations        ProfitSimulation[]
  /// 自動探索から追加された場合の探索結果 (識別用。監査ログ discovery.auto_add / discovery.add にも記録)
  discoveredItems    DiscoveredItem[]

  @@unique([platform, externalId])
}

model PriceSnapshot {
  id         String   @id @default(cuid())
  productId  String
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  currency   String   @db.VarChar(3)
  priceTiers Json
  moq        Int
  inStock    Boolean
  stockQty   Int?
  capturedAt DateTime @default(now())

  @@index([productId, capturedAt])
}

model ProfitSimulation {
  id              String   @id @default(cuid())
  /// 自動計算かどうかと、そのきっかけ (product.create / price.change / fx.refresh / settings.change / manual)
  auto            Boolean  @default(false)
  trigger         String?
  productId       String
  product         Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  quantity        Int
  /// 計算に用いた全パラメータ (再現性のため丸ごと保存)
  params          Json
  /// 費目別内訳 (円)
  breakdown       Json
  totalCostJpy    Decimal  @db.Decimal(14, 2)
  revenueJpy      Decimal  @db.Decimal(14, 2)
  profitJpy       Decimal  @db.Decimal(14, 2)
  unitProfitJpy   Decimal  @db.Decimal(14, 2)
  roiPercent      Decimal  @db.Decimal(9, 2)
  marginPercent   Decimal  @db.Decimal(9, 2)
  fxRateApplied   Decimal  @db.Decimal(14, 6)
  createdAt       DateTime @default(now())
}

model NegotiationGoal {
  id               String   @id @default(cuid())
  supplierId       String
  supplier         Supplier @relation(fields: [supplierId], references: [id])
  productId        String?
  targetUnitPrice  Decimal? @db.Decimal(14, 4)
  currency         String?  @db.VarChar(3)
  targetMoq        Int?
  wantsOem         Boolean  @default(false)
  notes            String?
  active           Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model ChatMessage {
  id             String        @id @default(cuid())
  supplierId     String
  supplier       Supplier      @relation(fields: [supplierId], references: [id])
  threadId       String
  direction      ChatDirection
  /// 原文 (中国語 / 英語)
  originalText   String
  originalLang   String?
  /// 日本語訳
  translatedText String?
  /// AI 返信案 (日本語の意図 + 送信用原語)
  draftText      String?
  draftTextJa    String?
  /// 返信本文が AI 案か、人が書いたものか
  draftSource    DraftSource?
  /// 承認者が最終確定した送信本文
  finalText      String?
  status         ChatStatus    @default(RECEIVED)
  approvedBy     String?
  approvedAt     DateTime?
  rejectedReason String?
  sentAt         DateTime?
  externalMsgId  String?
  /// 楽観ロック用バージョン
  version        Int           @default(0)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([threadId, createdAt])
  @@index([status])
}

model Notification {
  id        String           @id @default(cuid())
  type      NotificationType
  severity  Severity         @default(INFO)
  title     String
  body      String?
  link      String?
  meta      Json?
  readAt    DateTime?
  createdAt DateTime         @default(now())

  @@index([readAt, createdAt])
}

model AuditLog {
  id         String   @id @default(cuid())
  actor      String
  action     String
  entityType String
  entityId   String
  before     Json?
  after      Json?
  createdAt  DateTime @default(now())

  @@index([entityType, entityId])
}

/// 為替レートキャッシュ
model FxRate {
  id        String   @id @default(cuid())
  base      String   @db.VarChar(3)
  quote     String   @db.VarChar(3)
  rate      Decimal  @db.Decimal(14, 6)
  source    String
  fetchedAt DateTime @default(now())

  @@index([base, quote, fetchedAt])
}

/// スクレイピング対象のプラットフォーム別稼働状態 (CAPTCHA検知時に一時停止)
model ScraperState {
  platform  Platform @id
  paused    Boolean  @default(false)
  reason    String?
  pausedAt  DateTime?
  updatedAt DateTime @updatedAt
}

enum Role {
  ADMIN
  MEMBER
}

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  name         String
  passwordHash String
  role         Role      @default(MEMBER)
  disabled     Boolean   @default(false)
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  sessions     Session[]
  pushSubscriptions PushSubscription[]
}

/// Web Push の購読 (端末ごと)
model PushSubscription {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint   String    @unique
  p256dh     String
  auth       String
  userAgent  String?
  failures   Int       @default(0)
  lastUsedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([userId])
}

/// アプリが自動生成して保持する鍵 (例: Web Push の VAPID 鍵)。環境変数で指定された場合はそちらを優先
model AppSecret {
  key       String   @id
  value     String
  createdAt DateTime @default(now())
}

/// ログインセッション。id にはトークンの SHA-256 ハッシュを保存し、生トークンは Cookie のみに置く
model Session {
  id        String   @id
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  userAgent String?
  createdAt DateTime @default(now())

  @@index([userId])
}

/// 自動利益計算の既定パラメータ (単一行: id = "default")
model ProfitSettings {
  id                         String   @id @default("default")
  fxBufferPercent            Decimal  @default(3) @db.Decimal(6, 3)
  /// 為替取得に失敗しキャッシュも無い場合の予備レート (例: {"USD":"150","CNY":"20.8"})
  fxFallbackRates            Json     @default("{\"USD\":\"150\",\"CNY\":\"20.8\",\"EUR\":\"160\"}")
  localShippingJpy           Decimal  @default(0) @db.Decimal(14, 2)
  agentFeePercent            Decimal  @default(5) @db.Decimal(6, 3)
  agentFixedJpy              Decimal  @default(0) @db.Decimal(14, 2)
  intlRatePerKgJpy           Decimal  @default(800) @db.Decimal(14, 2)
  intlMinChargeJpy           Decimal  @default(0) @db.Decimal(14, 2)
  volumetricDivisor          Int      @default(5000)
  weightStepKg               Decimal  @default(0.5) @db.Decimal(8, 3)
  fuelSurchargePercent       Decimal  @default(0) @db.Decimal(6, 3)
  defaultDutyPercent         Decimal  @default(5) @db.Decimal(6, 3)
  consumptionTaxPercent      Decimal  @default(10) @db.Decimal(6, 3)
  customsClearanceFeeJpy     Decimal  @default(3000) @db.Decimal(14, 2)
  japanCustomsRounding       Boolean  @default(true)
  platformFeePercent         Decimal  @default(10) @db.Decimal(6, 3)
  platformFixedFeePerUnitJpy Decimal  @default(0) @db.Decimal(14, 2)
  domesticShippingPerUnitJpy Decimal  @default(200) @db.Decimal(14, 2)
  otherCostsJpy              Decimal  @default(0) @db.Decimal(14, 2)
  /// ROI がこの値 (%) を下回ったら通知
  roiAlertPercent            Decimal  @default(20) @db.Decimal(8, 2)
  updatedAt                  DateTime @updatedAt
}

/// 自動探索の結果ステータス
enum DiscoveryStatus {
  /// 条件を満たし自動で仕入れ候補に追加した
  AUTO_ADDED
  /// 利用者が手動で追加した
  ADDED
  /// 条件を満たすが追加していない (自動追加オフ・1回の上限超過)
  QUALIFIED
  BELOW_THRESHOLD
  NO_DOMESTIC_PRICE
  /// 同じ商品が仕入れ候補に登録済み
  DUPLICATE
  /// 利用者が除外した (再探索でも復活させない)
  DISMISSED
  ERROR
}

/// 自動探索の検索条件
model DiscoveryWatch {
  id                String           @id @default(cuid())
  name              String
  /// 国内価格の検索キーワード (日本語)
  keywordJa         String
  /// 海外サイト別の検索キーワード { ALIBABA?, ALIEXPRESS?, ALI1688? }。空なら keywordJa を翻訳して使う
  foreignKeywords   Json             @default("{}")
  /// 翻訳したキーワードのキャッシュ { ALIBABA: { source, text, stub } ... }
  autoKeywords      Json?
  platforms         Platform[]
  enabled           Boolean          @default(true)
  /// 試算の前提 (1 個あたり)
  estWeightKg       Decimal          @db.Decimal(10, 3)
  estLengthCm       Decimal?         @db.Decimal(10, 2)
  estWidthCm        Decimal?         @db.Decimal(10, 2)
  estHeightCm       Decimal?         @db.Decimal(10, 2)
  targetQuantity    Int              @default(1)
  /// 自動追加の条件
  minRoiPercent     Decimal          @db.Decimal(9, 2)
  minProfitJpy      Decimal?         @db.Decimal(14, 2)
  maxMoq            Int?
  maxUnitPriceJpy   Decimal?         @db.Decimal(14, 2)
  autoAdd           Boolean          @default(true)
  maxAutoAddPerRun  Int              @default(5)
  /// 直近の実行 (RUNNING / OK / PARTIAL / FAILED) と概要
  lastRunAt         DateTime?
  lastRunStatus     String?
  lastRunNote       String?
  createdById       String?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  items             DiscoveredItem[]
}

/// 自動探索で見つかった商品 (海外サイトの検索結果 1 件)
model DiscoveredItem {
  id                 String          @id @default(cuid())
  watchId            String
  watch              DiscoveryWatch  @relation(fields: [watchId], references: [id], onDelete: Cascade)
  platform           Platform
  externalId         String
  url                String
  title              String
  imageUrl           String?
  currency           String          @db.VarChar(3)
  /// 最安段階の単価 (外貨)
  unitPrice          Decimal         @db.Decimal(14, 4)
  /// 段階的単価: [{ minQty, unitPrice }]
  priceTiers         Json
  moq                Int             @default(1)
  supplierName       String?
  supplierExternalId String?
  shopUrl            String?
  /// 国内販売価格の採用値 (円) と根拠
  domesticPriceJpy   Decimal?        @db.Decimal(14, 2)
  domesticEvidence   Json?
  estProfitJpy       Decimal?        @db.Decimal(14, 2)
  estRoiPercent      Decimal?        @db.Decimal(9, 2)
  /// 試算の詳細 (数量・円換算単価・為替など)
  estimate           Json?
  status             DiscoveryStatus
  statusNote         String?
  productId          String?
  product            Product?        @relation(fields: [productId], references: [id], onDelete: SetNull)
  firstSeenAt        DateTime        @default(now())
  lastSeenAt         DateTime        @default(now())
  updatedAt          DateTime        @updatedAt

  @@unique([watchId, platform, externalId])
  @@index([status, lastSeenAt])
  @@index([watchId, lastSeenAt])
}

/// 国内価格の検索結果キャッシュ (24 時間)
model DomesticPriceCache {
  id        String   @id @default(cuid())
  provider  String
  keyword   String
  /// { items: [{ title, priceJpy, url, shop }] }
  result    Json
  fetchedAt DateTime @default(now())

  @@unique([provider, keyword])
}
